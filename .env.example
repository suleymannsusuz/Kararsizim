DJANGO_SECRET_KEY=degistir-beni
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Vercel'de bunlar sistem değişkenlerinden otomatik alınır; yalnızca özel alan adı için gerekir.
# DJANGO_SECURE=True canlı güvenlik ayarlarını (HTTPS yönlendirmesi, güvenli çerezler, HSTS) Vercel dışında açar.
# Boş bırakılırsa yerelde SQLite kullanılır.
# Supabase: Connect > Transaction pooler bağlantı dizesi (port 6543), parolayı URL-kodlayarak yaz:
# DATABASE_URL=postgresql://postgres.<proje-ref>:<parola>@<bolge>.pooler.supabase.com:6543/postgres
DATABASE_URL=
